{
  "components": {
    "schemas": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "Criterion": {
        "additionalProperties": false,
        "properties": {
          "operator": {
            "enum": [
              "<=",
              ">=",
              "=="
            ],
            "title": "Operator",
            "type": "string"
          },
          "threshold": {
            "$ref": "#/components/schemas/Quantity"
          }
        },
        "required": [
          "operator",
          "threshold"
        ],
        "title": "Criterion",
        "type": "object"
      },
      "DeviceModel": {
        "additionalProperties": false,
        "description": "Declared reference behavior, not compiled firmware or real network traffic.",
        "properties": {
          "boot_output": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Boot Output",
            "type": "number"
          },
          "model_version": {
            "const": "lamp-behavior-1",
            "default": "lamp-behavior-1",
            "title": "Model Version",
            "type": "string"
          },
          "offline_policy": {
            "default": "hold",
            "enum": [
              "hold",
              "off"
            ],
            "title": "Offline Policy",
            "type": "string"
          },
          "sensor_fault_output": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Sensor Fault Output",
            "type": "number"
          }
        },
        "title": "DeviceModel",
        "type": "object"
      },
      "Fact": {
        "additionalProperties": false,
        "properties": {
          "provenance": {
            "default": "declared",
            "enum": [
              "declared",
              "external_measurement"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "source_ref": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Ref",
            "type": "string"
          }
        },
        "required": [
          "quantity",
          "source_ref"
        ],
        "title": "Fact",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Quantity": {
        "additionalProperties": false,
        "properties": {
          "unit": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "title": "Quantity",
        "type": "object"
      },
      "Requirement": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "$ref": "#/components/schemas/Criterion"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "required": {
            "default": true,
            "title": "Required",
            "type": "boolean"
          },
          "required_fidelity": {
            "default": "F2",
            "enum": [
              "F0",
              "F1",
              "F2",
              "F3",
              "F4",
              "F5"
            ],
            "title": "Required Fidelity",
            "type": "string"
          },
          "rule_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "rule_id",
          "criterion"
        ],
        "title": "Requirement",
        "type": "object"
      },
      "Scenario": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "requirement_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Requirement Id",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "id",
          "requirement_id",
          "steps"
        ],
        "title": "Scenario",
        "type": "object"
      },
      "Step": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "enum": [
              "on",
              "off",
              "dim",
              "disconnect",
              "reconnect",
              "power_cycle",
              "sensor_fault"
            ],
            "title": "Event",
            "type": "string"
          },
          "expected_connected": {
            "title": "Expected Connected",
            "type": "boolean"
          },
          "expected_output": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Expected Output",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "event",
          "expected_output",
          "expected_connected"
        ],
        "title": "Step",
        "type": "object"
      },
      "Twin": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRef"
            },
            "maxItems": 20,
            "title": "Artifacts",
            "type": "array"
          },
          "facts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Fact"
            },
            "maxProperties": 100,
            "title": "Facts",
            "type": "object"
          },
          "revision_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Revision Id",
            "type": "string"
          },
          "twin_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Twin Id",
            "type": "string"
          }
        },
        "required": [
          "twin_id",
          "revision_id"
        ],
        "title": "Twin",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerificationRequest": {
        "additionalProperties": false,
        "properties": {
          "approval_ref": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Approval Ref",
            "type": "string"
          },
          "behavior_model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_id": {
            "const": "smart-lamp-analytical-v1",
            "default": "smart-lamp-analytical-v1",
            "title": "Profile Id",
            "type": "string"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Requirements",
            "type": "array"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "maxItems": 20,
            "title": "Scenarios",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "twin": {
            "$ref": "#/components/schemas/Twin"
          },
          "visual": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VisualComparison"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "approval_ref",
          "twin",
          "requirements"
        ],
        "title": "VerificationRequest",
        "type": "object"
      },
      "VisualComparison": {
        "additionalProperties": false,
        "properties": {
          "approval_ref": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Approval Ref",
            "type": "string"
          },
          "candidate": {
            "$ref": "#/components/schemas/ArtifactRef"
          },
          "candidate_context_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Candidate Context Sha256",
            "type": "string"
          },
          "candidate_revision_id": {
            "title": "Candidate Revision Id",
            "type": "string"
          },
          "reference": {
            "$ref": "#/components/schemas/ArtifactRef"
          },
          "reference_context_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Reference Context Sha256",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "candidate",
          "candidate_revision_id",
          "reference_context_sha256",
          "candidate_context_sha256",
          "approval_ref"
        ],
        "title": "VisualComparison",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MetaForge Verification",
    "version": "0.1.0"
  },
