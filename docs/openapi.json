{
  "components": {
    "schemas": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "Assumption": {
        "additionalProperties": false,
        "properties": {
          "accepted_by": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted By"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "unconfirmed",
              "accepted",
              "confirmed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state"
        ],
        "title": "Assumption",
        "type": "object"
      },
      "ConceptRevision": {
        "additionalProperties": false,
        "description": "Declared facts about a design's intent, parts and context. Immutable input.",
        "properties": {
          "assumptions": {
            "items": {
              "$ref": "#/components/schemas/Assumption"
            },
            "maxItems": 200,
            "title": "Assumptions",
            "type": "array"
          },
          "concept_mesh": {
            "default": false,
            "title": "Concept Mesh",
            "type": "boolean"
          },
          "functions": {
            "items": {
              "$ref": "#/components/schemas/Function"
            },
            "maxItems": 200,
            "title": "Functions",
            "type": "array"
          },
          "interface_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Interface Count",
            "type": "integer"
          },
          "ledger": {
            "items": {
              "$ref": "#/components/schemas/LedgerRow"
            },
            "maxItems": 500,
            "title": "Ledger",
            "type": "array"
          },
          "markets": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Markets",
            "type": "array"
          },
          "number": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/Part"
            },
            "maxItems": 500,
            "title": "Parts",
            "type": "array"
          },
          "process": {
            "$ref": "#/components/schemas/ProcessContext"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/RequirementItem"
            },
            "maxItems": 500,
            "title": "Requirements",
            "type": "array"
          },
          "revision_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Revision Id",
            "type": "string"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioItem"
            },
            "maxItems": 200,
            "title": "Scenarios",
            "type": "array"
          },
          "screening_stored": {
            "default": false,
            "title": "Screening Stored",
            "type": "boolean"
          },
          "twin_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Twin Id",
            "type": "string"
          }
        },
        "required": [
          "twin_id",
          "revision_id"
        ],
        "title": "ConceptRevision",
        "type": "object"
      },
      "Criterion": {
        "additionalProperties": false,
        "properties": {
          "operator": {
            "enum": [
              "<=",
              ">=",
              "=="
            ],
            "title": "Operator",
            "type": "string"
          },
          "threshold": {
            "$ref": "#/components/schemas/Quantity"
          }
        },
        "required": [
          "operator",
          "threshold"
        ],
        "title": "Criterion",
        "type": "object"
      },
      "DeviceModel": {
        "additionalProperties": false,
        "description": "Declared reference behavior, not compiled firmware or real network traffic.",
        "properties": {
          "boot_output": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Boot Output",
            "type": "number"
          },
          "model_version": {
            "const": "lamp-behavior-1",
            "default": "lamp-behavior-1",
            "title": "Model Version",
            "type": "string"
          },
          "offline_policy": {
            "default": "hold",
            "enum": [
              "hold",
              "off"
            ],
            "title": "Offline Policy",
            "type": "string"
          },
          "sensor_fault_output": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Sensor Fault Output",
            "type": "number"
          }
        },
        "title": "DeviceModel",
        "type": "object"
      },
      "Fact": {
        "additionalProperties": false,
        "properties": {
          "provenance": {
            "default": "declared",
            "enum": [
              "declared",
              "external_measurement"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "source_ref": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Ref",
            "type": "string"
          }
        },
        "required": [
          "quantity",
          "source_ref"
        ],
        "title": "Fact",
        "type": "object"
      },
      "Fix": {
        "additionalProperties": false,
        "description": "A structured hint. It names what is needed and where from, never a value.",
        "properties": {
          "needs": {
            "maxLength": 300,
            "title": "Needs",
            "type": "string"
          },
          "op": {
            "enum": [
              "set",
              "add",
              "remove"
            ],
            "title": "Op",
            "type": "string"
          },
          "pointer": {
            "maxLength": 300,
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": [
          "op",
          "pointer",
          "needs"
        ],
        "title": "Fix",
        "type": "object"
      },
      "Function": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "part_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Part Id"
          }
        },
        "required": [
          "id"
        ],
        "title": "Function",
        "type": "object"
      },
      "GateResult": {
        "additionalProperties": false,
        "properties": {
          "advisory": {
            "default": 0,
            "title": "Advisory",
            "type": "integer"
          },
          "assumed": {
            "default": 0,
            "title": "Assumed",
            "type": "integer"
          },
          "blocking": {
            "default": 0,
            "title": "Blocking",
            "type": "integer"
          },
          "decision": {
            "enum": [
              "pass",
              "fail",
              "incomplete"
            ],
            "title": "Decision",
            "type": "string"
          },
          "gate": {
            "enum": [
              "config_valid",
              "handover",
              "define_exit"
            ],
            "title": "Gate",
            "type": "string"
          },
          "rule_version": {
            "title": "Rule Version",
            "type": "string"
          }
        },
        "required": [
          "gate",
          "rule_version",
          "decision"
        ],
        "title": "GateResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LedgerRow": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "id"
        ],
        "title": "LedgerRow",
        "type": "object"
      },
      "Part": {
        "additionalProperties": false,
        "properties": {
          "has_envelope": {
            "default": false,
            "title": "Has Envelope",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "interface_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Interface Count",
            "type": "integer"
          },
          "retrieved": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "required": [
          "id"
        ],
        "title": "Part",
        "type": "object"
      },
      "ProcessContext": {
        "additionalProperties": false,
        "properties": {
          "material": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "process": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Process"
          },
          "quantity": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          }
        },
        "title": "ProcessContext",
        "type": "object"
      },
      "Quantity": {
        "additionalProperties": false,
        "properties": {
          "unit": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "title": "Quantity",
        "type": "object"
      },
      "Ref": {
        "additionalProperties": false,
        "description": "A stable address for what a finding is about.",
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "studio",
              "part",
              "ledger_row",
              "requirement",
              "assumption",
              "scenario",
              "function",
              "interface",
              "process"
            ],
            "title": "Kind",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "Ref",
        "type": "object"
      },
      "Requirement": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "$ref": "#/components/schemas/Criterion"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "required": {
            "default": true,
            "title": "Required",
            "type": "boolean"
          },
          "required_fidelity": {
            "default": "F2",
            "enum": [
              "F0",
              "F1",
              "F2",
              "F3",
              "F4",
              "F5"
            ],
            "title": "Required Fidelity",
            "type": "string"
          },
          "rule_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "rule_id",
          "criterion"
        ],
        "title": "Requirement",
        "type": "object"
      },
      "RequirementItem": {
        "additionalProperties": false,
        "properties": {
          "has_test": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has Test"
          },
          "has_value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has Value"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "verification_defaulted": {
            "default": false,
            "title": "Verification Defaulted",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "title": "RequirementItem",
        "type": "object"
      },
      "Scenario": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "requirement_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Requirement Id",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "id",
          "requirement_id",
          "steps"
        ],
        "title": "Scenario",
        "type": "object"
      },
      "ScenarioItem": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "default": false,
            "title": "Confirmed",
            "type": "boolean"
          },
          "confirmed_by": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed By"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "origin": {
            "enum": [
              "person",
              "inferred"
            ],
            "title": "Origin",
            "type": "string"
          }
        },
        "required": [
          "id",
          "origin"
        ],
        "title": "ScenarioItem",
        "type": "object"
      },
      "Status": {
        "enum": [
          "pass",
          "fail",
          "assumed",
          "inconclusive",
          "not_assessed"
        ],
        "title": "Status",
        "type": "string"
      },
      "Step": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "enum": [
              "on",
              "off",
              "dim",
              "disconnect",
              "reconnect",
              "power_cycle",
              "sensor_fault"
            ],
            "title": "Event",
            "type": "string"
          },
          "expected_connected": {
            "title": "Expected Connected",
            "type": "boolean"
          },
          "expected_output": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Expected Output",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "event",
          "expected_output",
          "expected_connected"
        ],
        "title": "Step",
        "type": "object"
      },
      "Twin": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRef"
            },
            "maxItems": 20,
            "title": "Artifacts",
            "type": "array"
          },
          "facts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Fact"
            },
            "maxProperties": 100,
            "title": "Facts",
            "type": "object"
          },
          "revision_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Revision Id",
            "type": "string"
          },
          "twin_id": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Twin Id",
            "type": "string"
          }
        },
        "required": [
          "twin_id",
          "revision_id"
        ],
        "title": "Twin",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationFinding": {
        "additionalProperties": false,
        "properties": {
          "accepted_by": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Accepted By",
            "type": "array"
          },
          "check_id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Check Id",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 200,
            "title": "Evidence",
            "type": "array"
          },
          "fix": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fix"
              },
              {
                "type": "null"
              }
            ]
          },
          "gate": {
            "enum": [
              "config_valid",
              "handover",
              "define_exit"
            ],
            "title": "Gate",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "title": "Message",
            "type": "string"
          },
          "resolver": {
            "enum": [
              "agent",
              "person",
              "external"
            ],
            "title": "Resolver",
            "type": "string"
          },
          "rule_version": {
            "maxLength": 50,
            "title": "Rule Version",
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ],
            "title": "Severity",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "target": {
            "$ref": "#/components/schemas/Ref"
          }
        },
        "required": [
          "id",
          "check_id",
          "rule_version",
          "gate",
          "severity",
          "status",
          "target",
          "message",
          "resolver"
        ],
        "title": "ValidationFinding",
        "type": "object"
      },
      "ValidationReport": {
        "additionalProperties": false,
        "properties": {
          "debt": {
            "items": {
              "$ref": "#/components/schemas/ValidationFinding"
            },
            "title": "Debt",
            "type": "array"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/ValidationFinding"
            },
            "title": "Findings",
            "type": "array"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/GateResult"
            },
            "title": "Gates",
            "type": "array"
          },
          "input_fingerprint": {
            "title": "Input Fingerprint",
            "type": "string"
          },
          "level": {
            "enum": [
              "V0",
              "V1",
              "V2"
            ],
            "title": "Level",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "profile_version": {
            "title": "Profile Version",
            "type": "string"
          },
          "revision_id": {
            "title": "Revision Id",
            "type": "string"
          },
          "revision_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision Number"
          },
          "schema_version": {
            "const": "2.0",
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          },
          "twin_id": {
            "title": "Twin Id",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "invalid",
              "needs_agent",
              "blocked_external",
              "needs_person",
              "ready_for_handover"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "profile_id",
          "profile_version",
          "twin_id",
          "revision_id",
          "input_fingerprint",
          "level",
          "gates",
          "findings",
          "debt",
          "verdict",
          "limitations"
        ],
        "title": "ValidationReport",
        "type": "object"
      },
      "ValidationRequest": {
        "additionalProperties": false,
        "properties": {
          "gates": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "config_valid",
                    "handover",
                    "define_exit"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gates"
          },
          "profile_id": {
            "const": "imagine-v1",
            "default": "imagine-v1",
            "title": "Profile Id",
            "type": "string"
          },
          "revision": {
            "$ref": "#/components/schemas/ConceptRevision"
          },
          "schema_version": {
            "const": "2.0",
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          },
          "scope": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Ref"
                },
                "maxItems": 200,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "supplied": {
            "items": {
              "$ref": "#/components/schemas/ValidationFinding"
            },
            "maxItems": 500,
            "title": "Supplied",
            "type": "array"
          }
        },
        "required": [
          "revision"
        ],
        "title": "ValidationRequest",
        "type": "object"
      },
      "VerificationRequest": {
        "additionalProperties": false,
        "properties": {
          "approval_ref": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Approval Ref",
            "type": "string"
          },
          "behavior_model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_id": {
            "const": "smart-lamp-analytical-v1",
            "default": "smart-lamp-analytical-v1",
            "title": "Profile Id",
            "type": "string"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Requirements",
            "type": "array"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "maxItems": 20,
            "title": "Scenarios",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "twin": {
            "$ref": "#/components/schemas/Twin"
          },
          "visual": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VisualComparison"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "approval_ref",
          "twin",
          "requirements"
        ],
        "title": "VerificationRequest",
        "type": "object"
      },
      "VisualComparison": {
        "additionalProperties": false,
        "properties": {
          "approval_ref": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Approval Ref",
            "type": "string"
          },
          "candidate": {
            "$ref": "#/components/schemas/ArtifactRef"
          },
          "candidate_context_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Candidate Context Sha256",
            "type": "string"
          },
          "candidate_revision_id": {
            "title": "Candidate Revision Id",
            "type": "string"
          },
          "reference": {
            "$ref": "#/components/schemas/ArtifactRef"
          },
          "reference_context_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Reference Context Sha256",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "candidate",
          "candidate_revision_id",
          "reference_context_sha256",
          "candidate_context_sha256",
          "approval_ref"
        ],
        "title": "VisualComparison",
        "type": "object"
      }
    }
  },
